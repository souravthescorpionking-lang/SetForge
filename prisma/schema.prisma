// SetForge — workout tracker data model
// Portable schema: no vendor extensions, no DB-side logic (DDL only).
// IDs are UUIDv7 generated app-side (src/lib/uuid7.ts) — schema defaults are fallback only.
// Note: sandbox uses SQLite; enums are stored as strings (validated app-side by Zod).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Auth ----------

model User {
  id           String   @id
  email        String   @unique
  name         String?
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settings     UserSettings?
  categories   Category[]
  exercises    Exercise[]
  workouts     Workout[]
  routines     Routine[]
  measurements Measurement[]
  plates       Plate[]
  goals        Goal[]
  timerPresets TimerPreset[]
  sessions     Session[]
  resetTokens  PasswordResetToken[]
  activeRoutine ActiveRoutine?
  scheduleEntries ScheduleEntry[]
  profile    UserProfile?
  // ---- Part 7: tour system ----
  tourStates UserTourState[]
  hintStates UserHintState[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expiresAt  DateTime

  @@id([identifier, token])
}

// Password reset tokens (audit B8): stored SHA-256 hashed, single-use, 1h TTL.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------- User config ----------

model UserSettings {
  id                    String  @id
  userId                String  @unique
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme                 String  @default("system") // light | dark | system
  unitSystem            String  @default("metric") // metric | imperial
  weekStart             Int     @default(1) // 0=Sunday 1=Monday
  defaultWeightIncrement Float  @default(2.5)
  homeSetsShown         Int     @default(3)
  showCategory          Boolean @default(true)
  trackPR               Boolean @default(true)
  markSetsComplete      Boolean @default(false)
  autoSelectNextSet     Boolean @default(true)
  keepScreenOn          Boolean @default(false)
  estOneRmRepLimit      Int     @default(10)
  weeklyWorkoutTarget   Int     @default(0) // workouts per week goal (0 = off)
  // ---- set-table column visibility & behaviour (Part 2) ----
  showSetType           Boolean @default(true)
  showRpe               Boolean @default(true)
  showTempo             Boolean @default(true)
  showRest              Boolean @default(true)
  autoRestFromRow       Boolean @default(true) // ✓ starts the row's planned rest
  restEndBehaviour      String  @default("NOTIFY_AND_FOCUS_NEXT") // NOTIFY | NOTIFY_AND_FOCUS_NEXT
  e1rmMethod            String  @default("BRZYCKI") // BRZYCKI | RPE | EPLEY
  // ---- Part 5: programs, sessions, scheduling ----
  timezone              String  @default("UTC") // IANA tz; client sends browser tz at signup
  autoAdvanceRest       Boolean @default(true) // REST cursor day auto-advances after local midnight
  scheduleMovesCursor   Boolean @default(true) // logging a scheduled active-routine day advances cursor
  advanceTrigger        String  @default("FINISH_OR_MIDNIGHT") // FINISH_OR_MIDNIGHT | FIRST_SET
  showProjectedDays     Boolean @default(false) // calendar ghosts upcoming cursor days
  reminderTime          String? // "HH:MM" local daily reminder (null = off)
  // ---- Part 6: feature expansion (defaults preserve Part 1-5 behaviour) ----
  guidedMode          Boolean @default(false) // guided set-by-set session pointer
  restDisplay         String  @default("BAR") // BAR | RING (RING adds in-flow RestRingBlock)
  autoMoveNextSet     Boolean @default(false) // pointer/focus advances after rest
  hapticsEnabled      Boolean @default(true)
  showVideoPanel      Boolean @default(true) // guided-mode per-exercise video block
  showMuscleChips     Boolean @default(true)
  showEquipmentChips  Boolean @default(true)
  finishBehaviour     String  @default("ALWAYS_SAVE") // ALWAYS_SAVE | ASK (discard option)
  showSetsProgressBar Boolean @default(true) // 4px bar inside DateStrip SubBar
  showMaxWeightBar    Boolean @default(true) // "Best W×R" line in ExerciseCard meta
  calendarStyle       String  @default("GRID") // GRID | SCROLL (continuous months)
  tempoPresets        Json? // string[]; default ["2-0-2-0","3-1-1-0","4-0-1-0","1-0-1-0"] applied app-side
  showCaloriesCard    Boolean @default(false) // Home calories card (manual kcal log)
  showThumbnails      Boolean @default(true) // library row thumbnails
  // ---- Part 8: phone-only redesign ----
  preset              String  @default("STANDARD") // SIMPLE | STANDARD | POWER (writes the individual switches)
  sessionMode         String  @default("AUTO") // AUTO | GUIDED | FREE (AUTO = guided when started from a program/session)
  defaultTransitionRestSec Int @default(0) // rest between groups (0 = off)
  notifScheduled      Boolean @default(false) // notify at scheduled session time
  notifMissedDay      Boolean @default(false) // missed-day nudge next morning (max 1/week)
  notifPr             Boolean @default(true) // in-app PR celebration toast
  // ---- Part 7: tour system ----
  showTours           Boolean @default(true) // auto-start screen tours + welcome tour
  showHints           Boolean @default(true) // contextual one-time hints
  replayToursOnUpdate Boolean @default(false) // auto-replay when a screen's tour version bumps
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// ---------- Part 7: tour system ----------

// One row per (user, screenId): the last outcome of that screen's tour.
// screenId is a route name ("home", "programs", …) or "__welcome" for the
// welcome tour. version mirrors the generated registry version hash — a
// mismatch means the tour content changed since the user last saw it.
model UserTourState {
  id          String   @id
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  screenId    String
  version     String
  status      String // SEEN | SKIPPED | COMPLETED
  stepReached Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([userId, screenId])
  @@index([userId])
}

// One row per (user, hintId): a contextual hint the user has dismissed.
model UserHintState {
  id      String   @id
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hintId  String
  seenAt  DateTime @default(now())

  @@unique([userId, hintId])
  @@index([userId])
}

// ---------- Exercise catalogue ----------

model Category {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  colour    String    @default("#f97316")
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  exercises Exercise[]

  @@unique([userId, name])
  @@index([userId])
}

model Exercise {
  id              String    @id
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name            String
  notes           String?
  type            String    @default("WEIGHT_REPS") // ExerciseType
  weightUnit      String? // override: kg | lbs (null = settings default)
  weightIncrement Float? // per-exercise stepper increment
  restSec         Int? // default rest timer
  defaultGraph    String? // preferred graph metric
  isFavorite      Boolean   @default(false)
  barWeight       Float? // per-exercise bar weight for plate calculator
  // ---- Part 8: per-exercise set-table column visibility + transition rest ----
  showRpe         Boolean @default(true)
  showTempo       Boolean @default(true)
  showRest        Boolean @default(true)
  transitionRestSec Int? // rest when the pointer moves to the next group (null = settings default)
  autoWarmup      Boolean   @default(false) // auto-open the warm-up ramp in the training screen
  // ---- Part 2: per-exercise set defaults ----
  defaultSetType  String? // NORMAL | WARMUP | DROP | FAILURE | AMRAP preset for new sets
  defaultRpeTarget Float? // suggested RPE for new sets
  defaultTempo    String? // suggested tempo, e.g. "3-1-1-0"
  // ---- Part 6: catalog metadata (additive; lists as Json — SQLite) ----
  primaryMuscles   Json? // string[] (Muscles enum values)
  secondaryMuscles Json? // string[]
  equipment        Json? // string[] (Equipment enum values)
  thumbnailUrl     String? // resolves via media adapter; null = no thumbnail
  videoUrl         String?
  trainerTip       String?
  setupNotes       String?
  targetNotes      String?
  catalogKey       String? // stable key of the SystemCatalog row this was adopted from
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  workoutExercises WorkoutExercise[]
  routineExercises RoutineExercise[]
  personalRecords  PersonalRecord[]
  goals            Goal[]

  @@unique([userId, name])
  @@unique([userId, catalogKey])
  @@index([userId, categoryId])
}

// ---------- Workouts ----------

model Workout {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime // UTC midnight of the workout day
  comment   String?
  startAt   DateTime?
  endAt     DateTime?
  // ---- Part 5: provenance ----
  sourceType      String    @default("FREESTYLE") // ROUTINE_DAY | SESSION | FREESTYLE | COPY
  sourceRoutine   Routine?  @relation("SourceRoutine", fields: [sourceRoutineId], references: [id], onDelete: SetNull)
  sourceRoutineId String? // routine/session the workout was started from (kept, routine delete → null)
  sourceDay       RoutineDay? @relation("SourceDay", fields: [sourceDayId], references: [id], onDelete: SetNull)
  sourceDayId     String? // routine day it was started from
  scheduledStart  Boolean   @default(false) // true = started from a PLANNED schedule entry
  finishedAt      DateTime? // set by the Finish action
  // ---- Part 8 §6.9: single remove semantics (replaces discardedAt/deletedAt pair) ----
  removedAt        DateTime? // set = hidden everywhere; listed under Backup & data -> Removed items
  removeReason     String? // USER_DELETE | DISCARDED_SESSION | HISTORY_PURGE
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  exercises WorkoutExercise[]
  groups    WorkoutGroup[]
  scheduleEntries ScheduleEntry[]

  @@index([userId, date])
  @@index([userId, sourceRoutineId])
  @@index([userId, removedAt])
}

model WorkoutGroup {
  id        String          @id
  userId    String
  workoutId String
  workout   Workout         @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  name      String
  colour    String          @default("#f97316")
  // ---- Part 8 §2.1: derived cache (recomputed on reorder, never user-edited) ----
  code      String? // group letter "A"
  size      Int? // member count
  createdAt DateTime        @default(now())

  exercises WorkoutExercise[]

  @@index([workoutId])
}

model WorkoutExercise {
  id         String   @id
  userId     String
  workoutId  String
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)
  groupId    String?
  group      WorkoutGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sets TrainingSet[]

  @@index([workoutId])
  @@index([exerciseId])
}

model TrainingSet {
  id                String          @id
  userId            String
  workoutExerciseId String
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  weight            Float?
  reps              Int?
  distance          Float?
  timeSec           Int?
  comment           String?
  isComplete        Boolean         @default(false)
  isWarmup          Boolean         @default(false) // mirrors setType == WARMUP (legacy flag, kept in sync)
  // ---- Part 2 set fields (all nullable / defaulted - additive migration) ----
  setType           String          @default("NORMAL") // SetType: NORMAL | WARMUP | DROP | FAILURE | AMRAP
  rpe               Float? // 6.0-10.0, step 0.5
  tempo             String? // "ecc-pause-con-pause", e.g. "3-1-1-0"
  restPlannedSec    Int?
  restActualSec     Int? // measured: previous completedAt -> this completedAt
  completedAt       DateTime?
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  personalRecords PersonalRecord[]

  @@index([workoutExerciseId])
}

model PersonalRecord {
  id         String   @id
  userId     String
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  reps       Int
  weight     Float
  setId      String?  @unique
  set        TrainingSet? @relation(fields: [setId], references: [id], onDelete: SetNull)
  date       DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([exerciseId, reps])
  @@index([userId, exerciseId])
}

// ---------- Routines ----------

model Routine {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  notes     String?
  kind      String    @default("ROUTINE") // ROUTINE (multi-day program) | SESSION (single-day)
  sortOrder Int       @default(0)
  // ---- Part 6: program metadata (additive) ----
  difficulty  String? // BEGINNER | INTERMEDIATE | ADVANCED
  phases      Json? // ordered [{ name, dayIds: string[] }]
  daysPerWeek Int?
  estMinutes  Int?
  highlights  Json? // string[] ≤4 short lines
  isFavorite  Boolean @default(false)
  labels      Json? // string[] user-defined tags
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  days RoutineDay[]
  groups RoutineGroup[]
  activeFor ActiveRoutine?
  scheduleEntries ScheduleEntry[]
  sourceWorkouts Workout[] @relation("SourceRoutine")

  @@index([userId])
}

model RoutineDay {
  id         String   @id
  userId     String
  routineId  String
  routine    Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  name       String
  dayType    String   @default("WORKOUT") // WORKOUT | REST
  sortOrder  Int      @default(0)
  // ---- Part 6 (additive) ----
  primaryMuscles Json? // string[] derived cache from exercises on save
  estMinutes     Int? // derived: Σ sets × (avg set 30s + rest)
  isFavorite     Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  exercises RoutineExercise[]
  scheduleEntries ScheduleEntry[]
  sourceWorkouts Workout[] @relation("SourceDay")

  @@index([routineId])
}

model RoutineGroup {
  id        String           @id
  userId    String
  routineId String
  routine   Routine          @relation(fields: [routineId], references: [id], onDelete: Cascade)
  name      String
  colour    String           @default("#f97316")
  // ---- Part 8 §2.1: derived cache ----
  code      String? // group letter "A"
  size      Int? // member count
  exercises RoutineExercise[]

  @@index([routineId])
}

model RoutineExercise {
  id         String    @id
  userId     String
  dayId      String
  day        RoutineDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sortOrder  Int       @default(0)
  groupId    String?
  group      RoutineGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  // ---- Part 8 §6.2: warm-up generator ----
  warmupScheme String? // NONE | STANDARD (40/60/80% x 5/3/2) | LIGHT (50/70% x 5/3) | CUSTOM
  warmupCustom Json? // [{ pct, reps }] when scheme = CUSTOM
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  sets PredefinedSet[]
  progressionRule ProgressionRule?
  progressionState ProgressionState?

  @@index([dayId])
  @@index([exerciseId])
}

model PredefinedSet {
  id                String          @id
  routineExerciseId String
  routineExercise   RoutineExercise @relation(fields: [routineExerciseId], references: [id], onDelete: Cascade)
  weight            Float?
  reps              Int?
  distance          Float?
  timeSec           Int?
  // ---- Part 2 template fields (null = copy previous / unset) ----
  setType           String? // null = NORMAL
  rpe               Float?
  tempo             String?
  restPlannedSec    Int?
  // ---- Part 8 §6.4: weight prescription kinds ----
  weightKind        String? // FIXED | COPY_LAST | PERCENT_1RM
  pct               Float? // % of e1RM when weightKind = PERCENT_1RM
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([routineExerciseId])
}

// ---------- Programs & scheduling (Part 5) ----------

// Cursor into the followed program. One per user. `cursorDayIndex` is a 0-based
// index into the routine's days (ordered by sortOrder); the server owns it.
model ActiveRoutine {
  id                  String    @id
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineId           String    @unique
  routine             Routine   @relation(fields: [routineId], references: [id], onDelete: Cascade)
  cursorDayIndex      Int       @default(0)
  startedAt           DateTime  @default(now())
  lastAdvancedAt      DateTime?
  lastAdvancedForDate String? // local YYYY-MM-DD of the last advance (idempotency for date-based advances)
  completedDayIds     Json    @default("[]") // persistent "Day completed" markers, independent of cursor
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId])
}

// Calendar scheduling. One PLANNED entry per (user, date); DONE entries are
// unlimited. Status is derived lazily on read (no cron).
model ScheduleEntry {
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime // UTC midnight of the scheduled day
  sourceType String // ROUTINE_DAY | SESSION
  routineId  String
  routine    Routine   @relation(fields: [routineId], references: [id], onDelete: Cascade)
  dayId      String?
  day        RoutineDay? @relation(fields: [dayId], references: [id], onDelete: Cascade)
  status     String    @default("PLANNED") // PLANNED | DONE | SKIPPED | MISSED
  workoutId  String?
  workout    Workout?  @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  note       String?
  // ---- Part 6 (additive) ----
  timeOfDay  String? // "HH:MM" local time-of-day (null = all-day)
  estMinutes Int?
  missedAt   DateTime? // set lazily when PLANNED → MISSED is derived
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([userId, date])
}

// ---------- Goals ----------

model Goal {
  id             String   @id
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId     String
  exercise       Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  type           String // ONE_RM | MAX_WEIGHT | MAX_REPS | MAX_DISTANCE | MAX_TIME | VOLUME
  targetWeight   Float?
  targetReps     Int?
  targetDistance Float?
  targetTimeSec  Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

// ---------- Body measurements ----------

model MeasurementUnit {
  id     String  @id
  userId String? // null = system unit
  name   String

  measurements Measurement[]

  @@unique([userId, name])
}

model Measurement {
  id          String   @id
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId      String
  unit        MeasurementUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  name        String
  goalType    String   @default("NONE") // INCREASE | DECREASE | SPECIFIC | NONE
  targetValue Float?
  isEnabled   Boolean  @default(true)
  isDefault   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  records MeasurementRecord[]

  @@unique([userId, name])
  @@index([userId])
}

model MeasurementRecord {
  id            String      @id
  userId        String
  measurementId String
  measurement   Measurement @relation(fields: [measurementId], references: [id], onDelete: Cascade)
  value         Float
  recordedAt    DateTime
  comment       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  photos        ProgressPhoto[]

  @@index([measurementId])
}

// ---------- Plates ----------

model Plate {
  id         String  @id
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  weight     Float
  colour     String  @default("#9ca3af")
  count      Int     @default(2)
  isAvailable Boolean @default(true)
  unitSystem String  @default("metric") // metric | imperial
  sortOrder  Int     @default(0)

  @@index([userId, unitSystem])
}

// ---------- Interval timer ----------

model TimerPreset {
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  prepareSec Int      @default(10)
  workSec    Int      @default(30)
  restSec    Int      @default(15)
  rounds     Int      @default(8)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, name])
}

// ---------- Part 6: profile, photos, calories, catalog ----------

model UserProfile {
  id        String    @id
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  age       Int?
  heightCm  Float?
  weightKg  Float?
  level     String? // BEGINNER | INTERMEDIATE | ADVANCED
  goal      String? // STRENGTH | MUSCLE | FAT_LOSS | GENERAL
  daysPerWeekTarget Int?
  onboardingCompletedAt DateTime? // null = onboarding pending; set on Finish OR Skip
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ProgressPhoto {
  id                 String    @id
  userId             String
  measurementRecordId String
  measurementRecord  MeasurementRecord @relation(fields: [measurementRecordId], references: [id], onDelete: Cascade)
  slot               String // FRONT | BACK | LEFT | RIGHT
  mediaKey           String // media-adapter key (users/{userId}/photos/...)
  width              Int
  height             Int
  createdAt          DateTime  @default(now())

  @@index([userId])
  @@index([measurementRecordId])
}

// ---------- Part 8 §6.3: progression rules & state ----------

model ProgressionRule {
  id                 String   @id
  userId             String
  routineExerciseId String   @unique
  routineExercise    RoutineExercise @relation(fields: [routineExerciseId], references: [id], onDelete: Cascade)
  type               String   @default("LINEAR") // LINEAR | DOUBLE | NONE
  increment          Float    @default(2.5)
  unit               String   @default("kg") // kg | lbs | %
  condition          String   @default("ALL_SETS_HIT") // ALL_SETS_HIT | LAST_SET_HIT
  failStreakForDeload Int    @default(2)
  deloadPct          Int      @default(10)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ProgressionState {
  id                 String   @id
  userId             String
  routineExerciseId String   @unique
  routineExercise    RoutineExercise @relation(fields: [routineExerciseId], references: [id], onDelete: Cascade)
  nextWeightDelta    Float    @default(0)
  failStreak         Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ---------- Part 8 §6.13: sync conflict log (read-only) ----------

model SyncConflict {
  id          String   @id
  userId      String
  table       String
  rowId       String
  field       String
  localValue  String?
  remoteValue String?
  resolvedWith String  // LOCAL | REMOTE | UNION
  at          DateTime @default(now())

  @@index([userId, at])
}

// ---------- Part 8 §6.8: scheduled backup runs ----------

model BackupRun {
  id        String   @id
  userId    String
  target    String // local | s3 | webdav
  status    String // OK | ERROR
  bytes     Int?
  at        DateTime @default(now())

  @@index([userId, at])
}

// System-level exercise catalog (not per user). Loaded from
// catalog/exercises.v1.json (builtin) or CATALOG_URL on boot; upsert by key.
model SystemCatalog {
  key              String   @id
  name             String
  category         String
  type             String   @default("WEIGHT_REPS")
  primaryMuscles   Json? // string[]
  secondaryMuscles Json? // string[]
  equipment        Json? // string[]
  setupNotes       String?
  targetNotes      String?
